# syntax=docker/dockerfile:1

# ---------------------------------------------------------------------------
# Front-end assets
#
# public/build is not in the repository, so Vite has to run here. The Bunny
# font plugin downloads the font files during this step, which is why the
# stage needs network access.
# ---------------------------------------------------------------------------
FROM node:22-bookworm-slim AS assets

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

COPY vite.config.js ./
COPY resources ./resources

# app.css points Tailwind at two paths outside resources/. Neither is present
# in this stage, so create them empty and let the globs resolve to nothing.
RUN mkdir -p \
        vendor/laravel/framework/src/Illuminate/Pagination/resources/views \
        storage/framework/views

RUN npm run build

# ---------------------------------------------------------------------------
# Base PHP image
# ---------------------------------------------------------------------------
FROM dunglas/frankenphp:1-php8.4-bookworm AS base

RUN cp "$PHP_INI_DIR/php.ini-production" "$PHP_INI_DIR/php.ini" \
    && install-php-extensions intl zip pdo_pgsql pdo_mysql opcache

WORKDIR /app

# ---------------------------------------------------------------------------
# PHP dependencies and build-time caches
# ---------------------------------------------------------------------------
FROM base AS dependencies

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

COPY composer.json composer.lock ./
RUN composer install \
        --no-dev \
        --no-interaction \
        --no-progress \
        --no-scripts \
        --optimize-autoloader \
        --prefer-dist

COPY . .
COPY --from=assets /app/public/build ./public/build

RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && composer dump-autoload --no-dev --classmap-authoritative \
    && php artisan package:discover --ansi \
    # Only the caches that do not bake in runtime environment values. Config is
    # deliberately left uncached so APP_KEY and the database credentials are
    # read when the container starts, not when the image is built.
    && php artisan view:cache \
    && php artisan route:cache

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
FROM base AS runtime

COPY --from=dependencies --chown=www-data:www-data /app /app
COPY --chown=www-data:www-data Caddyfile /etc/frankenphp/Caddyfile

RUN setcap CAP_NET_BIND_SERVICE=+eip /usr/local/bin/frankenphp \
    && chown -R www-data:www-data /config/caddy /data/caddy

# The container filesystem is not durable, so nothing that has to survive a
# request may live on it: sessions ride in an encrypted cookie and the basket,
# accounts and orders live in the database.
ENV PORT=80 \
    APP_ENV=production \
    APP_DEBUG=false \
    LOG_CHANNEL=stderr \
    CACHE_STORE=array \
    SESSION_DRIVER=cookie \
    QUEUE_CONNECTION=sync

USER www-data

CMD ["frankenphp", "run", "--config", "/etc/frankenphp/Caddyfile"]
